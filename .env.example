# Environment variables for LULUSANSTIMI
DATABASE_URL="mongodb://username:password@cluster.mongodb.net:27017/lulusanstimi?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin"

# Local Storage Directory (Relative to project root or absolute)
STORAGE_DIR="storage/uploads"

# PANDAWA Webhook Shared Secret
PANDAWA_WEBHOOK_SECRET="your_shared_webhook_secret_here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3022"
